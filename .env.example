# Browser flag only — gates whether the app attempts live Granite reasoning.
# The IBM Cloud API key must NEVER be VITE_-prefixed (it stays server-side).
VITE_GRANITE_ENABLED=

# Server-only watsonx.ai credentials (read by Vite /api/granite middleware)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Legacy / optional
# VITE_GEMINI_API_KEY=
# APP_URL=
